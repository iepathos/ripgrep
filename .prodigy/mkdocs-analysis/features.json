    "common_patterns": [
      {
        "name": "Search source code",
        "description": "Find patterns in specific programming languages",
        "example": "rg -t rust -t python 'TODO'"
      },
      {
        "name": "Search with context",
        "description": "Show surrounding lines for better understanding",
        "example": "rg -C 3 'error'"
      },
      {
        "name": "Search compressed logs",
        "description": "Search through gzipped log files",
        "example": "rg -z 'ERROR' logs/*.gz"
      },
      {
        "name": "Extract data with replacements",
        "description": "Transform and extract structured data",
        "example": "rg '(\\w+)@(\\w+\\.com)' -o -r '$1 at $2'"
      },
      {
        "name": "Search hidden files",
        "description": "Include dotfiles in search",
        "example": "rg --hidden --glob '!.git/' 'config'"
      },
      {
        "name": "Count occurrences",
        "description": "Count matches per file",
        "example": "rg -c 'function' --sort path"
      },
      {
        "name": "JSON output for processing",
        "description": "Machine-readable structured output",
        "example": "rg --json 'pattern' | jq '.data.lines.text'"
      },
      {
        "name": "Find function definitions",
        "description": "Search with context for understanding",
        "example": "rg -A 10 'fn main' src/"
      },
      {
        "name": "Multiline struct search",
        "description": "Search patterns across multiple lines",
        "example": "rg -U 'struct User \\{[^}]*email[^}]*\\}'"
      },
      {
        "name": "Exclude build artifacts",
        "description": "Search code excluding build directories",
        "example": "rg -g '!target/' -g '!node_modules/' 'TODO'"
      }
    ],
    "troubleshooting": {
      "common_issues": [
        {
          "issue": "Pattern doesn't match known content",
          "solution": "Check encoding with --debug, verify file has correct encoding or BOM. Try explicit encoding with -E."
        },
        {
          "issue": "Files are being ignored unexpectedly",
          "solution": "Use --debug to see why files are filtered. Try -u/-uu/-uuu to disable filtering. Check .gitignore patterns."
        },
        {
          "issue": "Compressed file not searched",
          "solution": "Verify file extension matches compression format. Ensure decompression tool is in PATH (gzip, xz, etc.)."
        },
        {
          "issue": "Slow search performance",
          "solution": "Check what's being searched with --files. Use file type filtering. Verify no network filesystems. Use --stats to profile."
        },
        {
          "issue": "Replacement not working as expected",
          "solution": "Always use single quotes for replacement strings to prevent shell expansion. Use braces ${1} to disambiguate."
        },
        {
          "issue": "Binary files not searched",
          "solution": "Binary files skipped by default in recursive search. Use --binary or -a to search them."
        },
        {
          "issue": "Hidden files not searched",
          "solution": "Hidden files excluded by default. Use --hidden or -u to include them."
        },
        {
          "issue": "No results found",
          "solution": "Check ignore files with --debug. Try --no-ignore. Verify pattern syntax. Use -F for literal search."
        },
        {
          "issue": "Can't match across lines",
          "solution": "Default is line-oriented. Use -U/--multiline for multi-line patterns."
        },
        {
          "issue": "Colors not showing",
          "solution": "Terminal may not support colors or output is piped. Use --color always to force."
        },
        {
          "issue": "Config file not loaded",
          "solution": "Check RIPGREP_CONFIG_PATH is set. Verify file location and syntax. Use --debug to see loaded config."
        },
        {
          "issue": "DFA gave up error",
          "solution": "Pattern too complex for default engine. Use -P for PCRE2 or increase --dfa-size-limit."
        },
        {
          "issue": "Missing decompression tool",
          "solution": "Install required tool (gzip, xz, zstd, etc.). Enable debug logging: RUST_LOG=debug rg -z 'pattern'"
        },
        {
          "issue": "Symlink loops",
          "solution": "When using -L/--follow, limit depth with --max-depth to prevent infinite loops."
        },
        {
          "issue": "Permission errors during recursive search",
          "solution": "ripgrep warns but continues. Use appropriate permissions or sudo if needed for restricted directories."
        }
      ]
    }
  },
