          "\\p{any} matches any character including newlines",
          "--multiline-dotall for . to match newlines",
          "Memory implications (reads entire files)",
          "Slower than line-by-line for most cases"
        ]
      },
      "pcre2_engine": {
        "description": "PCRE2 regex engine for advanced features",
        "features": [
          "-P/--pcre2 flag enables PCRE2",
          "Lookahead and lookbehind assertions",
          "Backreferences with \\1, \\2, etc.",
          "Named capture groups",
          "Conditional patterns",
          "--auto-hybrid-regex for automatic engine selection",
          "--engine option (default|pcre2|auto)"
