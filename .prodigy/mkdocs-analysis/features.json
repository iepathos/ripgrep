{
  "search_basics": {
    "type": "major_feature",
    "description": "Core search functionality for finding patterns in files",
    "capabilities": {
      "pattern_matching": {
        "description": "Find text using literal strings or regular expressions",
        "features": [
          "Literal string search with -F/--fixed-strings",
          "Regular expression patterns (default)",
          "Case-insensitive search with -i/--ignore-case",
          "Smart case with -S/--smart-case (case-insensitive unless uppercase present)",
          "Word boundary matching with -w/--word-regexp",
          "Line-oriented matching by default"
        ]
      },
      "multiple_patterns": {
        "description": "Search for multiple patterns simultaneously",
        "features": [
          "Multiple patterns with -e/--regexp flags",
          "Pattern files with -f/--file",
          "OR logic between patterns",
          "Boolean operations with combinations"
        ]
      },
      "recursive_search": {
        "description": "Search through directory trees automatically",
        "features": [
          "Recursive by default in current directory",
          "Specify paths to search",
          "Follow symlinks with -L/--follow",
          "Hidden file/directory control",
          "Maximum depth limits with --max-depth"
        ]
      }
    }
  },
  "filtering": {
    "type": "major_feature",
    "description": "Automatic and manual filtering of files and content",
    "automatic_filtering": {
      "description": "Files automatically excluded from search",
      "capabilities": {
        "ignore_files": {
          "description": "Respect version control and custom ignore patterns",
          "features": [
            ".gitignore file support",
            ".ignore file support (ripgrep-specific)",
            ".rgignore file support (legacy)",
            "Global gitignore support",
            ".git/info/exclude support",
            "Precedence ordering of ignore files"
          ]
        },
        "automatic_exclusions": {
          "description": "Default file/directory exclusions",
          "features": [
            "Hidden files/directories excluded by default",
            "Binary files excluded by default",
            "Parent gitignore files respected",
            "VCS directories (.git, .svn, etc.) excluded"
          ]
        },
        "override_flags": {
          "description": "Disable automatic filtering",
          "features": [
            "-u/--unrestricted flag (three levels: -u, -uu, -uuu)",
            "--no-ignore to skip ignore files",
            "--hidden to include hidden files",
            "--binary to search binary files",
            "Granular control with specific flags"
          ]
        }
      }
    },
    "manual_filtering": {
      "description": "Explicit file inclusion and exclusion",
      "capabilities": {
        "glob_patterns": {
          "description": "Include or exclude files by glob patterns",
          "features": [
            "-g/--glob for include/exclude patterns",
            "Multiple glob patterns supported",
            "Negation with ! prefix",
            "--iglob for case-insensitive globs",
            "Standard glob syntax (*, **, ?, [...])"
          ]
        },
        "file_types": {
          "description": "Filter by predefined or custom file types",
          "features": [
            "-t/--type to include file types (e.g., -tpy, -tjs)",
            "-T/--type-not to exclude file types",
            "Built-in types for common languages",
            "--type-list to show all types",
            "Custom type definitions with --type-add",
            "Multiple type specifications supported"
          ]
        }
      }
