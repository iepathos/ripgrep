  "meta_content": {
    "type": "meta",
    "description": "Cross-cutting documentation and guidance",
    "best_practices": {
      "performance": [
        "Use file type filters (-t) instead of globs when possible",
        "Avoid multiline mode unless necessary",
        "Use literal search (-F) when not needing regex",
        "Consider --max-filesize for repositories with large files",
        "Single-threaded mode for deterministic output"
      ],
      "pattern_writing": [
        "Start with simple patterns, add complexity as needed",
        "Test patterns on small datasets first",
        "Use word boundaries (-w) for exact word matches",
        "Prefer default engine over PCRE2 unless needed",
        "Use -F for literal strings with special characters"
      ],
      "filtering": [
        "Create .ignore files for project-specific exclusions",
        "Use -uuu only when truly needed (slow)",
        "Define custom file types for specialized formats",
        "Layer ignore files (global, repo, directory)",
        "Test glob patterns with --files first"
      ],
      "output": [
        "Use --json for programmatic consumption",
        "Context lines helpful for understanding matches",
        "Color output for human reading, --color never for scripts",
        "vimgrep format for editor integration",
        "Count mode for quick metrics"
      ]
    },
    "common_patterns": [
      {
        "name": "Log analysis",
        "description": "Search and highlight errors in logs",
        "example": "rg -i 'error|warning|critical' --passthru app.log"
      },
      {
        "name": "Code search with context",
        "description": "Find function definitions with surrounding code",
        "example": "rg -tjs -C 3 'function\\s+\\w+\\(' src/"
      },
      {
        "name": "Find todos by author",
        "description": "Locate TODO comments with names",
        "example": "rg 'TODO\\(\\w+\\):' -tcpp"
      },
      {
        "name": "Search specific file types only",
        "description": "Search Python files excluding tests",
        "example": "rg -tpy -g '!*test*' 'import requests'"
      },
      {
        "name": "JSON output for tools",
        "description": "Machine-readable output for processing",
        "example": "rg --json 'pattern' | jq '.data.lines.text'"
      },
      {
        "name": "Replace with preview",
        "description": "See replacements before applying",
        "example": "rg 'old_name' -r 'new_name' | less"
      },
      {
        "name": "Count occurrences by file",
        "description": "Find which files have most matches",
        "example": "rg -c 'function' --sort path"
      },
      {
        "name": "Search compressed logs",
        "description": "Look inside gzipped log archives",
        "example": "rg -z 'error' logs/*.gz"
      },
      {
        "name": "Multiline struct search",
        "description": "Find struct definitions spanning lines",
        "example": "rg -U 'struct User \\{[^}]*email[^}]*\\}'"
      },
      {
        "name": "Exclude build artifacts",
        "description": "Search code excluding build directories",
        "example": "rg -g '!target/' -g '!node_modules/' 'TODO'"
      }
    ],
    "troubleshooting": {
      "common_issues": [
        {
          "issue": "No files searched (empty results)",
          "solution": "Check gitignore files. Use --debug to see what files are filtered. Try -uuu to search all files."
        },
        {
          "issue": "Pattern not matching expected text",
          "solution": "Regex special characters need escaping. Use -F for literal strings. Check case sensitivity with -i."
        },
        {
          "issue": "Performance is slow",
          "solution": "Large files? Try --max-filesize. Too many files? Use file type filters (-t). Multiline? Avoid unless necessary."
        },
        {
          "issue": "Binary file matches not shown",
          "solution": "Binary files skipped by default. Use --binary or -a to search them."
        },
        {
          "issue": "Hidden files not searched",
          "solution": "Hidden files excluded by default. Use --hidden or -u to include them."
        },
        {
          "issue": "Regex DFA gave up",
          "solution": "Pattern too complex for default engine. Use -P for PCRE2 or simplify pattern."
        },
        {
          "issue": "Colors not showing",
          "solution": "Terminal may not support colors, or output is piped. Use --color always to force."
        },
        {
          "issue": "Can't match across lines",
          "solution": "Default is line-oriented. Use -U/--multiline for multi-line patterns."
        },
        {
          "issue": "Config file not loaded",
          "solution": "Check RIPGREP_CONFIG_PATH. Verify file location and syntax (one flag per line)."
        },
        {
          "issue": "Too many open files error",
          "solution": "Reduce thread count with -j or increase system file descriptor limit (ulimit)."
        }
      ]
    }
  },
