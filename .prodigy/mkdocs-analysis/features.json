      },
      "unicode_support": {
        "description": "Full Unicode pattern matching",
        "features": [
          "Unicode enabled by default",
          "Unicode categories (\\p{Letter}, \\p{Number})",
          "Unicode scripts (\\p{Greek}, \\p{Han})",
          "Case-insensitive Unicode matching",
          "Grapheme cluster awareness"
